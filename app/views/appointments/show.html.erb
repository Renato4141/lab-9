<h1>Appointment</h1>

<p><strong>Date:</strong> <%= @appointment.date.strftime("%B %d, %Y %H:%M") %></p>
<p><strong>Pet:</strong> <%= link_to @appointment.pet.name, pet_path(@appointment.pet) if @appointment.pet %></p>
<p><strong>Vet:</strong> <%= link_to @appointment.vet.first_name, vet_path(@appointment.vet) if @appointment.vet %></p>
<p><strong>Reason:</strong> <%= @appointment.reason %></p>
<p><strong>Status:</strong> <%= @appointment.status&.humanize %></p>

<div class="mb-3">
  <% if policy(@appointment).update? %>
    <%= link_to "Edit", edit_appointment_path(@appointment), class: "btn btn-warning" %>
  <% end %>

  <% if policy(@appointment).destroy? %>
    <%= button_to "Delete", appointment_path(@appointment),
          method: :delete,
          data: { turbo_confirm: "Are you sure?" },
          class: "btn btn-danger d-inline" %>
  <% end %>

  <%= link_to "Back", appointments_path, class: "btn btn-secondary" %>
</div>

<h2>Treatments</h2>

<% if policy(Treatment.new(appointment: @appointment)).create? %>
  <%= link_to "New Treatment", new_appointment_treatment_path(@appointment), class: "btn btn-primary mb-3" %>
<% end %>

<ul class="list-group">
  <% @appointment.treatments.each do |t| %>
    <li class="list-group-item">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <strong><%= t.name %></strong><br>

          <small>
            <%= t.medication %> - <%= t.dosage %>
          </small>

          <div class="mt-2">
            <%= t.clinical_notes %>
          </div>

          <small class="text-muted">
            Administered at:
            <%= t.administered_at.strftime("%B %d, %Y %H:%M") if t.administered_at %>
          </small>
        </div>

        <div>
          <% if policy(t).update? %>
            <%= link_to "Edit",
                  edit_appointment_treatment_path(@appointment, t),
                  class: "btn btn-sm btn-warning" %>
          <% end %>

          <% if policy(t).destroy? %>
            <%= button_to "Delete",
                  appointment_treatment_path(@appointment, t),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure?" },
                  class: "btn btn-sm btn-danger mt-1" %>
          <% end %>
        </div>
      </div>
    </li>
  <% end %>
</ul>