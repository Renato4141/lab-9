<%= form_with(model: pet, class: "needs-validation") do |form| %>
  <% if pet.errors.any? %>
    <div class="alert alert-danger">
      <h4 class="alert-heading"><%= pluralize(pet.errors.count, "error") %> prohibited this pet from being saved:</h4>
      <ul>
        <% pet.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :species, class: "form-label" %>
    <%= form.select :species, %w[dog cat rabbit bird reptile other], { include_blank: true }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :breed, class: "form-label" %>
    <%= form.text_field :breed, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :date_of_birth, class: "form-label" %>
    <%= form.date_field :date_of_birth, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :weight, class: "form-label" %>
    <%= form.number_field :weight, step: 0.1, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :owner_id, class: "form-label" %>
    <%= form.collection_select :owner_id, Owner.all, :id, :full_name, { include_blank: true }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :photo, class: "form-label" %>
    <% if pet.photo.attached? %>
      <div class="mb-2">
        <p class="form-text text-muted">Current photo</p>
        <%= image_tag pet.photo.variant(resize_to_limit: [100, 100]), class: "img-thumbnail" %>
      </div>
    <% end %>
    <%= form.file_field :photo, class: "form-control" %>
    <% if pet.errors[:photo].any? %>
      <div class="text-danger mt-1">
        <%= pet.errors[:photo].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>