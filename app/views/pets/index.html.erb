<h1>Pets</h1>

<% if policy(Pet.new).create? %>
  <%= link_to "New Pet", new_pet_path, class: "btn btn-primary mb-3" %>
<% end %>

<table class="table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Species</th>
      <th>Breed</th>
      <th>Owner</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @pets.each do |pet| %>
      <tr>
        <td><%= link_to pet.name, pet %></td>
        <td><%= pet.species %></td>
        <td><%= pet.breed %></td>
    <td>
      <% if pet.owner && policy(pet.owner).show? %>
        <%= link_to pet.owner.first_name, owner_path(pet.owner) %>
      <% else %>
        <%= pet.owner&.first_name %>
    <% end %>
    </td>

        <td>
          <% if policy(pet).update? %>
            <%= link_to "Edit", edit_pet_path(pet), class: "btn btn-sm btn-warning" %>
          <% end %>

          <% if policy(pet).destroy? %>
            <%= button_to "Delete", pet_path(pet),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure?" },
                  class: "btn btn-sm btn-danger" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>