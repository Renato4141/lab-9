<h1><%= @vet.first_name %> <%= @vet.last_name %></h1>

<p>Email: <%= @vet.email %></p>
<p>Phone: <%= @vet.phone %></p>
<p>Specialization: <%= @vet.specialization %></p>

<% if policy(@vet).update? %>
  <%= link_to "Edit", edit_vet_path(@vet), class: "btn btn-warning mb-3" %>
<% end %>

<h2>Appointments</h2>
<ul>
  <% @vet.appointments.each do |a| %>
    <li><%= link_to a.date, a %></li>
  <% end %>
</ul>